#include <cstdio>
#include <chrono>
#include <memory>
#include <algorithm>
#include "window/glfw_window.h"
#include "window/input/input_queue.h"
#include "window/input/input_event.h"
#include "log/core/log_macros.h"
#include "render/rhi/opengl_backend.h"
#include "render_system/frame/RenderFrameRunner.h"
#include "render_system/components/DirectionalLight.h"
#include "render_system/components/SkySettings.h"
#include "imgui/imgui_manager.h"
#include "imgui/imgui_panels.h"
#include "editor/editor_panels.h"
#include "ecs/component/transform_component.h"
#include "ecs/hierarchy/hierarchy.h"
#include "ecs/world/world.h"
#include "ecs/world/scheduler.h"
#include "ecs/query/query.h"
#include "ecs/type/types.h"
#include "ecs/type/atom_registry.h"
#include "ecs/world/app.h"
#include "ecs/event/events.h"
#include "ecs/event/event_lifetime.h"
#include <GLFW/glfw3.h>
#include <cstdlib>

// Forward declarations generated by Source Forest
@FORWARD_DECLS@

// Game plugin (defined in RuntimeLib)
#include "runtime/game_plugin.h"
#include "runtime/render_assets.h"

int main() {
    LOG_INFO(Entelechy::LogCategories::kEngine, "=== Entelechy Game Engine ===");
    LOG_INFO(Entelechy::LogCategories::kEngine, "Solution: @SOLUTION_NAME@");

    // Initialize modules
@INIT_CALLS@

    // Initialize logger
    Entelechy::Logger::instance().init("logs/engine.log");

    // Create window with a size appropriate for the primary monitor.
    int winW, winH;
    Entelechy::GlfwWindow::getRecommendedWindowSize(winW, winH);

    auto window = std::make_unique<Entelechy::GlfwWindow>();
    if (!window->create(winW, winH, "Entelechy Window")) {
        LOG_ERROR(Entelechy::LogCategories::kWindow, "Failed to create window");
        return -1;
    }
    window->centerOnScreen();

    LOG_INFO(Entelechy::LogCategories::kWindow, "Window created. Press ESC to close.");

    // Initialize graphics backend
    auto render = std::make_unique<Entelechy::OpenGLBackend>(window.get());
    if (!render->init(nullptr)) {
        LOG_ERROR(Entelechy::LogCategories::kEngine, "Failed to initialize graphics backend");
        return -1;
    }

    // Initialize ImGui (requires OpenGL context + GLFW window)
    auto imgui = std::make_unique<Entelechy::ImGuiManager>();
    if (!imgui->init(window->getGlfwWindow())) {
        LOG_ERROR(Entelechy::LogCategories::kEngine, "Failed to initialize ImGui");
        return -1;
    }

    // Register atom types for Inspector reflection
    Entelechy::AtomRegistry::instance().registerBuiltinAtoms();

    // ------------------------------------------------------------------
    // App + Plugins
    // ------------------------------------------------------------------
    Entelechy::App app;
    // Use App's emplacement so the plugin is allocated and freed by the same
    // allocator (DefaultAllocator / mimalloc). Mixing std::make_unique (global
    // new) with DefaultAllocator::free causes a crash on shutdown.
    app.emplacePlugin<game::GamePlugin>();
    // Mint the asset handles before setup() spawns the cooked scene.
    game::initRenderAssets();
    app.build();
    app.setup();

    Entelechy::World& world = app.world();
    Entelechy::Scheduler& scheduler = app.scheduler();
    world.bindCommandBuffer(&scheduler.commandBuffer());

    // Render frame runner (Extract -> Cull -> Queue -> Execute)
    Entelechy::RenderFrameRunner frameRunner;
    if (!frameRunner.init(window.get())) {
        LOG_ERROR(Entelechy::LogCategories::kEngine, "Failed to init render frame runner");
        return -1;
    }

    // Bind the game-side asset storages to the Prepare stage. GPU resources
    // (meshes/materials/textures) are resolved from the extracted handles
    // automatically each frame; assets still streaming in draw as the
    // fallback cube / pink material.
    {
        game::RenderAssets& assets = game::renderAssets();
        frameRunner.prepare().bindAssets(&assets.mesh_assets, &assets.material_assets, &assets.texture_assets);
    }

    // Event loop with DeltaTime
    using Clock = std::chrono::high_resolution_clock;
    auto lastTime = Clock::now();

    float fps = 0.0f;
    float fpsTimer = 0.0f;
    int frameCount = 0;

    // Clear color shared between engine and ImGui debug panel
    float clearColor[4] = {0.15f, 0.17f, 0.13f, 1.0f};
    bool autoRunSystems = true;

    while (!window->shouldClose() && app.isRunning()) {
        auto now = Clock::now();
        float dt = std::chrono::duration<float>(now - lastTime).count();
        lastTime = now;

        // Clamp extreme delta times (e.g. after breakpoint)
        dt = std::clamp(dt, 0.0f, 0.1f);

        Entelechy::Logger::instance().flush();

        window->pollEvents();

        // Consume raw input
        for (const auto& e : Entelechy::InputQueue::instance().events()) {
            switch (e.type) {
                case Entelechy::RawInputEvent::KeyPress:
                    LOG_DEBUG(Entelechy::LogCategories::kInput, "KeyPress key=%d", e.keyCode);
                    if (e.keyCode == GLFW_KEY_ESCAPE) {
                        window->requestClose();
                    }
                    if (e.keyCode == GLFW_KEY_SPACE) {
                        Entelechy::Entity evt = world.spawn();
                        world.addComponent<Entelechy::EventLifetime>(evt, {scheduler.currentFrame()});
                        world.addComponent<Entelechy::KeyboardEvent>(evt, {GLFW_KEY_SPACE, true});
                    }
                    break;
                case Entelechy::RawInputEvent::KeyRelease:
                    LOG_DEBUG(Entelechy::LogCategories::kInput, "KeyRelease key=%d", e.keyCode);
                    break;
                case Entelechy::RawInputEvent::MouseMove:
                    LOG_DEBUG(Entelechy::LogCategories::kInput, "MouseMove x=%.1f y=%.1f", e.mx, e.my);
                    break;
                case Entelechy::RawInputEvent::MouseButtonPress:
                    LOG_DEBUG(Entelechy::LogCategories::kInput, "MouseButtonPress button=%d", e.mouseButton);
                    break;
                case Entelechy::RawInputEvent::MouseButtonRelease:
                    LOG_DEBUG(Entelechy::LogCategories::kInput, "MouseButtonRelease button=%d", e.mouseButton);
                    break;
                case Entelechy::RawInputEvent::WindowResize:
                    LOG_DEBUG(Entelechy::LogCategories::kWindow, "WindowResize %dx%d", e.width, e.height);
                    break;
                case Entelechy::RawInputEvent::Close:
                    LOG_DEBUG(Entelechy::LogCategories::kWindow, "Close");
                    break;
            }
        }

        // ===== Tick systems (before rendering so Extract sees this frame's transforms) =====
        if (autoRunSystems) {
            app.update(dt);
        }

        // Consume completed async asset loads (fills Assets<T> on the main thread)
        game::renderAssets().asset_server.processEvents();

        // ===== ImGui: begin new frame =====
        imgui->newFrame();

        // ===== Build UI =====
        int currentW, currentH;
        window->getSize(currentW, currentH);

        // Mirror the first main-world directional light into the debug
        // panel and write edits back the same frame (Phase 5a).
        Entelechy::DirectionalLightParams lightParams;
        Entelechy::DirectionalLight* sunLight = nullptr;
        {
            Entelechy::Query<Entelechy::DirectionalLight> lightQuery(world);
            for (auto [lightEntity, light] : lightQuery) {
                (void)lightEntity;
                sunLight = light;
                break;
            }
        }
        if (sunLight) {
            lightParams.direction[0] = sunLight->direction.x;
            lightParams.direction[1] = sunLight->direction.y;
            lightParams.direction[2] = sunLight->direction.z;
            lightParams.color[0] = sunLight->color.x;
            lightParams.color[1] = sunLight->color.y;
            lightParams.color[2] = sunLight->color.z;
            lightParams.intensity = sunLight->intensity;
            lightParams.ambient = sunLight->ambient;
        }

        // Mirror the first main-world sky settings into the debug panel and
        // write edits back the same frame (Phase 5c).
        Entelechy::SkyParams skyParams;
        Entelechy::SkySettings* skySettings = nullptr;
        {
            Entelechy::Query<Entelechy::SkySettings> skyQuery(world);
            for (auto [skyEntity, sky] : skyQuery) {
                (void)skyEntity;
                skySettings = sky;
                break;
            }
        }
        if (skySettings) {
            skyParams.horizonColor[0] = skySettings->horizon_color.x;
            skyParams.horizonColor[1] = skySettings->horizon_color.y;
            skyParams.horizonColor[2] = skySettings->horizon_color.z;
            skyParams.zenithColor[0] = skySettings->zenith_color.x;
            skyParams.zenithColor[1] = skySettings->zenith_color.y;
            skyParams.zenithColor[2] = skySettings->zenith_color.z;
            skyParams.enabled = skySettings->enabled;
        }

        Entelechy::WindowSizeRequest sizeRequest;
        Entelechy::buildDebugPanel(dt, fps, clearColor, sunLight ? &lightParams : nullptr,
                                   skySettings ? &skyParams : nullptr, currentW, currentH, sizeRequest);

        if (sunLight) {
            sunLight->direction = {lightParams.direction[0], lightParams.direction[1], lightParams.direction[2]};
            sunLight->color = {lightParams.color[0], lightParams.color[1], lightParams.color[2]};
            sunLight->intensity = lightParams.intensity;
            sunLight->ambient = lightParams.ambient;
        }
        if (skySettings) {
            skySettings->horizon_color = {skyParams.horizonColor[0], skyParams.horizonColor[1], skyParams.horizonColor[2]};
            skySettings->zenith_color = {skyParams.zenithColor[0], skyParams.zenithColor[1], skyParams.zenithColor[2]};
            skySettings->enabled = skyParams.enabled;
        }
        {
            const auto& rstats = frameRunner.stats();
            Entelechy::RenderStatsParams statsParams;
            statsParams.fps = fps;
            statsParams.drawCalls = rstats.draw_calls;
            statsParams.visible = rstats.visible;
            statsParams.culled = rstats.culled;
            statsParams.total = rstats.total_renderables;
            statsParams.psoCacheSize = rstats.pso_cache_size;
            statsParams.trackedMemoryBytes = rstats.tracked_memory_bytes;
            statsParams.gpuTotalBytes = rstats.gpu_total_bytes;
            statsParams.gpuAvailableBytes = rstats.gpu_available_bytes;
            Entelechy::buildRenderStatsPanel(statsParams);
        }

        if (sizeRequest.requested) {
            if (sizeRequest.width < 0 || sizeRequest.height < 0) {
                Entelechy::GlfwWindow::getRecommendedWindowSize(sizeRequest.width, sizeRequest.height);
            }
            window->setSize(sizeRequest.width, sizeRequest.height);
            window->centerOnScreen();
        }

        // ===== ImGui: generate draw data =====
        imgui->render();

        // ===== Render frame =====
        render->beginFrame();
        render->setClearColor(clearColor[0], clearColor[1], clearColor[2], clearColor[3]);
        render->clear();

        // ===== Render frame: Extract -> Cull -> Queue -> Execute =====
        frameRunner.runFrame(world, dt);

        // ===== ImGui: submit draw data (overlay on top of 3D) =====
        imgui->renderDrawData();
        imgui->updatePlatformWindows();

        render->present();

        // ===== GPU resource lifecycle: signal frame fence and flush safe deletes =====
        frameRunner.endFrame();

        // ===== Clear input queue (after systems have consumed this frame's events) =====
        Entelechy::InputQueue::instance().clear();

        // ===== FPS counter =====
        fpsTimer += dt;
        frameCount++;
        if (fpsTimer >= 1.0f) {
            fps = static_cast<float>(frameCount);
            fpsTimer = 0.0f;
            frameCount = 0;
            const auto& rstats = frameRunner.stats();
            LOG_INFO(Entelechy::LogCategories::kEngine,
                     "Frame stats: %.0f fps, draw_calls=%u, visible=%u, culled=%u, total=%u",
                     static_cast<double>(fps), rstats.draw_calls, rstats.visible, rstats.culled,
                     rstats.total_renderables);
        }
    }

    app.teardown();

    // Shutdown order: render frame runner, then ImGui (uses GL context), then render, then window
    frameRunner.shutdown();
    imgui->shutdown();
    render->shutdown();
    window->destroy();

    LOG_INFO(Entelechy::LogCategories::kEngine, "Window closed. Goodbye.");
    return 0;
}
